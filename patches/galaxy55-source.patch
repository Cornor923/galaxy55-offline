diff -ruN '--exclude=*.swf' '--exclude=*.png' '--exclude=*.ods' WebGamesArchives/Galaxy55/fla/explore/src/exp/OfflineData.hx build/G55/fla/explore/src/exp/OfflineData.hx
--- WebGamesArchives/Galaxy55/fla/explore/src/exp/OfflineData.hx	1970-01-01 00:00:00.000000000 +0000
+++ build/G55/fla/explore/src/exp/OfflineData.hx	2026-10-13 13:29:04.182146586 +0000
@@ -0,0 +1,68 @@
+package exp;
+import ExploreProtocol;
+
+// Datos de sector/sistemas generados localmente (sustituye al servidor de Motion Twin)
+class OfflineData {
+
+	static var NAMES = ["Aldebar","Brume","Cyrene","Dorian","Eskel","Fenris","Galata","Hespera","Ikaros","Jovan","Kestrel","Lumen"];
+
+	static function generateSolarSystem( id : Int, seed : Int ) : SystemInfos {
+		var rseed = new mt.Rand(seed);
+		var infos : SystemInfos = {
+			id : id,
+			seed : seed,
+			name : "Sistema " + NAMES[id % NAMES.length],
+			planets : new Array(),
+			x : 20 + id * 3,
+			y : 25,
+			status : SystemStatus.SOpen,
+		}
+		var biomes = [ Common.BiomeKind.BIAutumn, Common.BiomeKind.BIMars, Common.BiomeKind.BIMoon, Common.BiomeKind.BIWinterPeaks ];
+		var bnames = [ "Otono", "Marte", "Luna", "Picos nevados" ];
+		for( i in 0...rseed.random(3) + 2 ) {
+			var bi = rseed.random(biomes.length);
+			var p : SystemPlanetInfos = {
+				id : i,
+				seed : seed + i,
+				size : rseed.random(4) + 1,
+				distance : i,
+				name : infos.name + " " + (i + 1),
+				status : SystemPlanetStatus.PActive,
+				kind : SystemPlanetKind.SPlanet,
+				biome : biomes[bi],
+				bname : bnames[bi],
+			}
+			infos.planets.push(p);
+		}
+		return infos;
+	}
+
+	public static function getInfos() : ExploreInfos {
+		var seed = 1 + Std.random(999998);
+		var h = new Hash<String>();
+		h.set("loading", "Cargando...");
+		h.set("land", "Aterrizar");
+		h.set("scan", "Escanear");
+		h.set("unlockSystem", "Desbloquear");
+		h.set("noLicense", "Sin licencia");
+		h.set("welcome", "Bienvenido");
+		var d : ExploreInfos = {
+			url : null,
+			ship : { data : null, pos : ShipPosition.PInSector(30, 30), energy : 100 },
+			sector : { id : 0, seed : seed, width : 50, height : 50, name : "Sector " + seed },
+			systems : new Array(),
+			holes : new Array(),
+			freeLicense : true,
+			texts : h,
+		}
+		var rseed = new mt.Rand(seed);
+		for( i in 0...10 )
+			d.systems.push(generateSolarSystem(i, seed + i));
+		rseed.initSeed(seed);
+		for( s in d.systems ) {
+			s.x += rseed.random(2);
+			s.y += rseed.random(20);
+		}
+		return d;
+	}
+}
